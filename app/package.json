{
  "name": "mondig-app",
  "private": true,
  "license": "EUPL-1.2",
  "version": "0.3.0-dev",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "node ../scripts/model-licenties.mjs --check && vitest run",
    "tauri": "tauri",
    "vermeldingen": "node ../scripts/vermeldingen.mjs",
    "bundel": "node ../scripts/engine-bundelen.mjs && tauri build --config src-tauri/tauri.bundel.conf.json",
    "dev:app": "cargo build -p mondig-engine && tauri dev"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@lucide/svelte": "1.67.0",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "4.3.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^26",
    "bits-ui": "2.20.4",
    "clsx": "2.1.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.14.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "svelte": "5.57.3",
    "svelte-check": "^4.7.8",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "4.0.1",
    "tailwindcss": "4.3.4",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.60.1",
    "vite": "8.3.5",
    "vitest": "^5.1.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
