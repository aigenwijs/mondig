{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mondig",
  "identifier": "com.aigenwijs.spraak",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run vermeldingen && npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mondig",
        "width": 900,
        "height": 780,
        "minWidth": 480,
        "minHeight": 400,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; media-src blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "14.2",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    }
  }
}
