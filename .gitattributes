# Tekst altijd met LF in de repo, ook op Windows
* text=auto eol=lf

# Windows-scripts houden CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binair
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.svg text
*.woff2 binary
*.ttf binary

# Lockfiles niet diffen in reviews
Cargo.lock linguist-generated=true -diff
package-lock.json linguist-generated=true -diff
